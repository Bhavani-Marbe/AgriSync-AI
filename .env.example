# ==========================================
# AgriSync Platform Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Vision Pathology, Agronomist Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# PORT: Server port (Hardcoded to 3000 by infrastructure reverse proxy)
PORT=3000

# NODE_ENV: Runtime environment (development / production)
NODE_ENV=production

# JWT_SECRET: Secret key for signing JWT tokens in backend services
JWT_SECRET=agrisync_jwt_production_super_secret_key_2026

# DATABASE_URL: PostgreSQL Connection String (Optional for full backend persistence)
DATABASE_URL=postgres://agrisync_user:agrisync_password@localhost:5432/agrisync_db
